# Copy to apps/web/.env.local and fill in yourself. Never commit real values,
# never paste them into Claude. Same keys go in Vercel → Project → Settings → Environment Variables.

MONGODB_URI=
MONGODB_DB=claimsense_dev
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACT=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
SESSION_TTL_DAYS=7
CLAIM_TTL_DAYS=7
GUEST_TTL_HOURS=24
MAX_UPLOAD_MB=4
MAX_FILES_PER_CLAIM=8
AI_DAILY_EXTRACTIONS_PER_USER=6
