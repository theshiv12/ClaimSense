{
  "name": "claimsense",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @claimsense/api --filter @claimsense/web run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm --filter @claimsense/web exec next typegen && eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:cov": "pnpm -r run test:cov",
    "cases": "pnpm --filter @claimsense/rules run cases",
    "check:env": "pnpm --filter @claimsense/api run check:env"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "globals": "17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.2"
  }
}
