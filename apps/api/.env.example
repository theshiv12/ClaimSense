# Copy to apps/api/.env.local and fill in yourself. Never commit real values, never paste them into Claude.
# Same keys go on the API host (Render, a second Vercel project, any Node 24 host).

MONGODB_URI=
MONGODB_DB=claimsense_dev
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACT=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
SESSION_TTL_DAYS=7
CLAIM_TTL_DAYS=7
GUEST_TTL_HOURS=24
MAX_UPLOAD_MB=4
MAX_FILES_PER_CLAIM=8
AI_DAILY_EXTRACTIONS_PER_USER=6
# "Ask about this check" questions per signed-up user per day (ADR-010).
AI_DAILY_CHATS_PER_USER=20
PORT=4000
# The web app's origin: the only one allowed to send writes (CSRF check).
WEB_ORIGIN=http://localhost:3000
# Express trust proxy. Keep 'loopback': per-IP limits use the client IP the web proxy vouches for (below),
# never a client-sent X-Forwarded-For.
TRUST_PROXY=loopback
# A long random string (16+ chars), the same in apps/web. The web proxy sends the client IP with it;
# the API trusts that IP only when this matches. Generate one: openssl rand -hex 24
PROXY_SECRET=
