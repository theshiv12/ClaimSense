{
  "name": "@claimsense/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "check:env": "node --env-file-if-exists=.env.local scripts/check-env.mjs",
    "eval:live": "tsx --env-file-if-exists=.env.local evals/live.ts"
  },
  "dependencies": {
    "@claimsense/rules": "workspace:*",
    "@claimsense/shared": "workspace:*",
    "@google/genai": "2.31.0",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongoose": "9.11.4",
    "multer": "2.5.0",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.4",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.0.4"
  }
}
